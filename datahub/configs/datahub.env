# DataHub スタック用の環境変数．
# --env-file として up.sh から渡す（upstream compose の ${VAR} 置換に使われる）．
#
# --- バージョン変数の紛らわしい点（重要） ---
# 同じ「DATAHUB_VERSION」という名前が，このファイルと
# shared/scripts/versions.env とで異なる意味を持つ．
#   - このファイル（datahub.env）の DATAHUB_VERSION:
#       upstream compose の image: acryldata/datahub-gms:${DATAHUB_VERSION} 等に
#       そのまま埋め込まれる「イメージタグ」．acryldata の Docker Hub タグは
#       v 接頭辞付き（v1.7.0）なので，ここは v1.7.0 と書く必要がある．
#       v なし（1.7.0）を指定すると manifest unknown で pull に失敗する．
#   - shared/scripts/versions.env の DATAHUB_VERSION:
#       fetch-compose.sh が upstream compose の取得 URL を組み立てるための
#       git タグ由来の値で，v なし（1.7.0）が正しい（スクリプト側で
#       .../v${DATAHUB_VERSION}/... のように v を付与している）．
# つまり実体は同じ DataHub 1.7.0 だが，表記（v の有無）が置き場所によって違う．
# バージョンを上げるときは両方のファイルを揃えて変更すること．
DATAHUB_VERSION=v1.7.0

# UI からインジェスト実行するときに使われる acryl-datahub（PyPI）のデフォルト
# バージョン．PyPI 側のバージョン表記に v は付かないので v なし．
# Containerfile.ingestion の pip install バージョンとも揃えること．
UI_INGESTION_DEFAULT_CLI_VERSION=1.7.0

# --- トークンサービスの salt / signing key ---
# これは「秘密」ではない．このローカル検証環境専用の固定値であり，
# 本番相当の利用では必ず別のランダム値に変更すること．
# 公式 quickstart は実行のたびにランダム生成した値を使うが，本リポジトリは
# 検証環境の再現性（何度 up/down してもトークンの検証結果が変わらないこと）を
# 優先して固定値にしている．
DATAHUB_TOKEN_SERVICE_SALT=local-lab-not-a-secret-salt-9f2c7a1d
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=local-lab-not-a-secret-signing-key-3e81b4c0

# --- ポートについて ---
# DATAHUB_MAPPED_GMS_PORT / DATAHUB_MAPPED_FRONTEND_PORT は upstream compose の
# ports 定義内でのみ参照される変数だが，本リポジトリでは ports を
# compose.override.yml / compose.altports.yml 側で `ports: !override` として
# リテラル値に置き換えているため，ここに書いても効かない
# （podman-compose 1.6.0 が !override タグ内で ${VAR} を展開しない不具合がある．
#  OpenMetadata 側と同じ制約）．そのためこのファイルには含めない．
#
# OpenMetadata と同時起動したい場合（mysql/opensearch/gms が 3306/9200/8080 で
# 衝突する）は次のように DATAHUB_ALT_PORTS=1 を付けて起動する．
#   DATAHUB_ALT_PORTS=1 ./datahub/scripts/up.sh
# これで mysql は 23306，opensearch は 29200，gms は 28080 に変わる．
# frontend-quickstart の 9002 は OpenMetadata と衝突しないため変わらない．
