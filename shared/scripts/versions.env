# バージョンと取得元 URL の一元管理．
# このファイルは source される前提の単純な変数代入のみ．シェバンや実行権限は付けない．

# --- ツールのバージョン固定（latest は使わない） ---
# 注意: OM_VERSION は upstream compose の取得 URL 用のリリースタグ．
# upstream compose が既定で参照するイメージは docker.getcollate.io ミラーの 2.0.0 だが，
# このミラーは匿名 pull の制限が厳しく実機で toomanyrequests になるため，
# openmetadata/configs/openmetadata.env で docker.io/openmetadata/*:2.0.1 に上書きしている．
# その結果 OM_VERSION と実際のイメージタグは一致する．
OM_VERSION=2.0.1
DATAHUB_VERSION=1.7.0

# --- UI ポート ---
OM_UI_PORT=8585
DATAHUB_UI_PORT=9002

# --- upstream compose の取得元 URL ---
# OpenMetadata: GitHub Release の MySQL 版を既定とする．
#（PostgreSQL 版は同ディレクトリの docker-compose-postgres.yml）
OM_COMPOSE_URL="https://github.com/open-metadata/OpenMetadata/releases/download/${OM_VERSION}-release/docker-compose.yml"

# DataHub: quickstart profile 版．
DATAHUB_COMPOSE_URL="https://raw.githubusercontent.com/datahub-project/datahub/v${DATAHUB_VERSION}/docker/quickstart/docker-compose.quickstart-profile.yml"
