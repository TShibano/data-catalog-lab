# バージョンと取得元 URL の一元管理．
# このファイルは source される前提の単純な変数代入のみ．シェバンや実行権限は付けない．

# --- ツールのバージョン固定（latest は使わない） ---
# 注意: OM_VERSION は upstream compose の取得 URL 用のリリースタグ．
# upstream compose が既定で参照するイメージは docker.getcollate.io ミラーの 2.0.0 だが，
# このミラーは匿名 pull の制限が厳しく実機で toomanyrequests になるため，
# openmetadata/configs/openmetadata.env で docker.io/openmetadata/*:2.0.1 に上書きしている．
# その結果 OM_VERSION と実際のイメージタグは一致する．
OM_VERSION=2.0.1
DATAHUB_VERSION=1.7.0

# --- ホスト側から到達するポート ---
# ここに置くのは「スクリプトがホストから叩くポート」だけ．
# mysql / elasticsearch / opensearch / kafka のようにスクリプトが直接触らない
# ポートは compose 側のリテラル値だけが定義になる．
#
# ポート割り当ての全体像は README.md の「ポート割り当て」の表を唯一の参照先とし，
# ここと各 compose.override.yml の値を手で揃える
# （compose の !override タグの中では ${VAR} が展開されないため，
#  compose 側から本ファイルを参照させることはできない．
#  詳細は openmetadata/compose.override.yml のコメントを参照）．
OM_UI_PORT=8585
OM_ADMIN_PORT=8586
DATAHUB_UI_PORT=9002
DATAHUB_GMS_PORT=8080

# --- compose プロジェクト名 ---
# podman-compose はプロジェクト名を compose 実行時の作業ディレクトリ名から決める
# （実測・2026-09-07）．各 up.sh は自分のツールのディレクトリへ cd してから
# compose を叩くため，プロジェクト名はディレクトリ名と一致する．
# 「他方のスタックが起動中か」をコンテナのラベルで調べるのに使う．
OM_COMPOSE_PROJECT=openmetadata
DATAHUB_COMPOSE_PROJECT=datahub

# --- 要求リソース ---
# up.sh が preflight に渡す値．単体起動か同時起動かで切り替える．
# メモリ（MiB）は compose.override.yml の mem_limit 合計を基準にする．
#   OpenMetadata 7g（mysql 1 + elasticsearch 2 + server 2 + ingestion 2）
#   DataHub      8g（opensearch 2 + kafka 1 + gms 2 + frontend 1 + mysql 1 + actions 1）
#   サンプル DB  0.5g
# 同時起動の合計は 15.5g．mem_limit を持たない起動時ジョブ（OpenMetadata の
# execute-migrate-all，DataHub の system-update-quickstart）の分を上乗せして
# 16384MiB を要求する．podman machine は 18GiB を推奨（README.md 参照）．
OM_REQUIRED_MEM_MIB=6144
DATAHUB_REQUIRED_MEM_MIB=8192
BOTH_REQUIRED_MEM_MIB=16384

# ディスク（GB）．同時起動時は両ツールのイメージが同居するため
# イメージ実測（OpenMetadata 約 7.8GB + DataHub 約 7.25GB）とボリュームを見込む．
OM_REQUIRED_DISK_GB=13
DATAHUB_REQUIRED_DISK_GB=13
BOTH_REQUIRED_DISK_GB=25

# --- upstream compose の取得元 URL ---
# OpenMetadata: GitHub Release の MySQL 版を既定とする．
#（PostgreSQL 版は同ディレクトリの docker-compose-postgres.yml）
OM_COMPOSE_URL="https://github.com/open-metadata/OpenMetadata/releases/download/${OM_VERSION}-release/docker-compose.yml"

# DataHub: quickstart profile 版．
DATAHUB_COMPOSE_URL="https://raw.githubusercontent.com/datahub-project/datahub/v${DATAHUB_VERSION}/docker/quickstart/docker-compose.quickstart-profile.yml"
